/* ==============================
   全站基础样式
   ============================== */

html
  scroll-behavior smooth

body
  color #2c3e50
  background #ffffff


/* ==============================
   顶部导航栏
   ============================== */

.navbar
  box-shadow 0 1px 8px rgba(0, 0, 0, 0.04)
  border-bottom 1px solid #f0f0f0

.navbar .site-name
  font-weight 600

.navbar .links
  background transparent


/* ==============================
   导航链接
   ============================== */

.nav-links a
  transition color .2s ease

.nav-links a:hover
  color #3eaf7c


/* ==============================
   正文
   ============================== */

.theme-default-content
  font-size 16px
  line-height 1.85

.theme-default-content p
  margin 1.1em 0


/* ==============================
   标题
   ============================== */

.theme-default-content h2
  margin-top 2.2em
  padding-bottom .45rem
  border-bottom 1px solid #eaecef

.theme-default-content h3
  margin-top 1.8em


/* ==============================
   链接
   ============================== */

.theme-default-content a
  text-decoration none

.theme-default-content a:hover
  text-decoration underline


/* ==============================
   行内代码
   ============================== */

.theme-default-content code
  padding .2rem .4rem
  border-radius 4px


/* 防止代码块内部 code 被上面的行内代码影响 */

.theme-default-content pre code
  padding 0
  border-radius 0


/* ==============================
   引用
   ============================== */

.theme-default-content blockquote
  margin 1.5rem 0
  padding .8rem 1.2rem

  border-left 4px solid #3eaf7c

  background #f8f9fa

  color #666


/* ==============================
   图片
   ============================== */

.theme-default-content img
  border-radius 6px


/* ==============================
   页面切换动画
   ============================== */

.page
  animation pageFadeIn .25s ease

@keyframes pageFadeIn
  from
    opacity 0
    transform translateY(4px)

  to
    opacity 1
    transform translateY(0)


/* ==============================
   手机端
   ============================== */

@media (max-width: 719px)
   .theme-default-content
    padding: 72px 18px 32px
    font-size 15px
    line-height 1.8
    /* ============================================================
 * 移动端适配
 * ============================================================ */

@media (max-width: 719px)

  /* ----------------------------------------------------------
   * 1. 全局页面
   * ---------------------------------------------------------- */

  html,
  body
    overflow-x: hidden


  body
    font-size: 15px


  /* ----------------------------------------------------------
   * 2. 顶部导航
   * ---------------------------------------------------------- */

  .navbar
    padding: 0 16px

    height: 56px


  .navbar .site-name
    font-size: 16px

    max-width: 130px

    overflow: hidden

    text-overflow: ellipsis

    white-space: nowrap


  /* ----------------------------------------------------------
   * 3. Logo
   * ---------------------------------------------------------- */

  .navbar .logo
    width: 28px

    height: 28px

    margin-right: 8px

    object-fit: cover


  /* ----------------------------------------------------------
   * 4. 搜索框
   * ---------------------------------------------------------- */

  .navbar .search-box
    margin-right: 8px

    transform: scale(0.92)

    transform-origin: right center


  .navbar .search-box input
    width: 110px


  /* ----------------------------------------------------------
   * 5. 导航菜单
   * ---------------------------------------------------------- */

  .navbar .links
    padding-left: 0


  .navbar .nav-item
    font-size: 14px


  /* ----------------------------------------------------------
   * 6. 首页主体
   * ---------------------------------------------------------- */

  .theme-container
    overflow-x: hidden


  .page
    padding: 0 16px


  /* ----------------------------------------------------------
   * 7. 默认 VuePress 内容宽度
   * ---------------------------------------------------------- */

  .theme-default-content
    padding: 32px 18px


  .theme-default-content:not(.custom)
    max-width: 100%


  /* ----------------------------------------------------------
   * 8. 首页 Hero
   * ---------------------------------------------------------- */

  .home
    padding-left: 16px

    padding-right: 16px


  /* ----------------------------------------------------------
   * 9. Hero 容器
   * ---------------------------------------------------------- */

  .home .hero
    padding-top: 30px

    padding-bottom: 30px


  /* ----------------------------------------------------------
   * 10. Hero 标题
   * ---------------------------------------------------------- */

  .home .hero h1
    font-size: 30px

    line-height: 1.35

    margin-bottom: 18px

    word-break: break-word


  /* ----------------------------------------------------------
   * 11. Hero 副标题
   * ---------------------------------------------------------- */

  .home .hero .description
    font-size: 15px

    line-height: 1.8

    padding: 0 4px


  /* ----------------------------------------------------------
   * 12. Hero 按钮
   * ---------------------------------------------------------- */

  .home .hero .action-button
    font-size: 14px

    padding: 8px 16px

    margin: 6px 4px


  /* ----------------------------------------------------------
   * 13. 最新文章区域
   * ---------------------------------------------------------- */

  .home .features
    display: block


  /* ----------------------------------------------------------
   * 14. 首页文章卡片
   * ---------------------------------------------------------- */

  .home .custom-block
    margin-left: 0

    margin-right: 0


  /* ----------------------------------------------------------
   * 15. 文章卡片通用
   * ---------------------------------------------------------- */

  .post-list,
  .post-card,
  .article-card
    width: 100%

    box-sizing: border-box


  /* ----------------------------------------------------------
   * 16. 文章详情
   * ---------------------------------------------------------- */

  .page .content
    padding-bottom: 40px


  /* ----------------------------------------------------------
   * 17. 文章标题
   * ---------------------------------------------------------- */

  .page h1
    font-size: 28px

    line-height: 1.4

    word-break: break-word


  .page h2
    font-size: 22px

    line-height: 1.45


  .page h3
    font-size: 19px

    line-height: 1.5


  /* ----------------------------------------------------------
   * 18. 正文
   * ---------------------------------------------------------- */

  .page p,
  .page li
    font-size: 15px

    line-height: 1.9


  /* ----------------------------------------------------------
   * 19. 代码块
   * ---------------------------------------------------------- */

  .theme-default-content pre,
  .theme-default-content div[class*="language-"]
    border-radius: 8px


  .theme-default-content pre
    font-size: 13px

    line-height: 1.65

    overflow-x: auto


  /* ----------------------------------------------------------
   * 20. 表格
   * ---------------------------------------------------------- */

  .theme-default-content table
    display: block

    overflow-x: auto

    white-space: nowrap


  /* ----------------------------------------------------------
   * 21. 图片
   * ---------------------------------------------------------- */

  .theme-default-content img
    max-width: 100%

    height: auto


  /* ----------------------------------------------------------
   * 22. 引用
   * ---------------------------------------------------------- */

  .theme-default-content blockquote
    margin-left: 0

    margin-right: 0

    padding-left: 14px


  /* ----------------------------------------------------------
   * 23. 分页
   * ---------------------------------------------------------- */

  .pagination
    margin-left: 16px

    margin-right: 16px


  /* ----------------------------------------------------------
   * 24. 上一篇 / 下一篇
   * ---------------------------------------------------------- */

  .page-nav
    display: block


  .page-nav .inner
    display: block


  .page-nav .next,
  .page-nav .prev
    width: 100%

    box-sizing: border-box

    margin-bottom: 12px


  /* ----------------------------------------------------------
   * 25. 目录
   * ---------------------------------------------------------- */

  .page-toc
    display: none


  /* ----------------------------------------------------------
   * 26. 文章阅读区域
   * ---------------------------------------------------------- */

  .content__default
    overflow-x: hidden


  /* ----------------------------------------------------------
   * 27. About 页面
   * ---------------------------------------------------------- */

  .about-footer-note
    margin-top: 44px

    padding-top: 20px

    font-size: 12px


  /* ----------------------------------------------------------
   * 28. Footer
   * ---------------------------------------------------------- */

  .site-footer
    margin-top: 56px

    padding: 32px 18px 22px


  .site-footer-inner
    display: flex

    flex-direction: column

    align-items: flex-start

    gap: 20px


  .site-footer-right
    flex-wrap: wrap

    line-height: 1.8

    white-space: normal


  .site-footer-bottom
    margin-top: 22px

    text-align: left

    line-height: 1.8


  /* ----------------------------------------------------------
   * 29. 隐藏过度装饰
   * ---------------------------------------------------------- */

  .sidebar
    padding-top: 56px


  /* ----------------------------------------------------------
   * 30. 梅枝背景
   * ----------------------------------------------------------
   *
   * 手机屏幕较窄。
   *
   * 背景不需要完全消失，
   * 但可以稍微降低存在感。
   */

  .branch-background
    opacity: 0.72