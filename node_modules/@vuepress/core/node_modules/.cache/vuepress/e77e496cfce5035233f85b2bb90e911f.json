n  }\r\n\r\n  .navigation-title {\r\n    font-size: 14px;\r\n\r\n    line-height: 1.65;\r\n  }\r\n\r\n  .navigation-arrow {\r\n    right: 17px;\r\n\r\n    font-size: 17px;\r\n  }\r\n\r\n  .post-navigation-card.next .navigation-arrow {\r\n    left: 17px;\r\n\r\n    right: auto;\r\n  }\r\n\r\n  .post-navigation-placeholder {\r\n    display: none;\r\n  }\r\n}\r\n</style>\r\n"]}]}