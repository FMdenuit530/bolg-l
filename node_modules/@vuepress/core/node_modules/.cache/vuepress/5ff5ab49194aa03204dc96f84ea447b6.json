{"remainingRequest":"D:\\blog\\node_modules\\vue-loader\\lib\\index.js??vue-loader-options!D:\\blog\\docs\\.vuepress\\theme\\layouts\\Tag.vue?vue&type=style&index=0&id=9ba3b3f8&scoped=true&lang=css","dependencies":[{"path":"D:\\blog\\docs\\.vuepress\\theme\\layouts\\Tag.vue","mtime":1788445146131},{"path":"D:\\blog\\node_modules\\css-loader\\dist\\cjs.js","mtime":1788081846216},{"path":"D:\\blog\\node_modules\\vue-loader\\lib\\loaders\\stylePostLoader.js","mtime":1788081852152},{"path":"D:\\blog\\node_modules\\postcss-loader\\src\\index.js","mtime":1788081846550},{"path":"D:\\blog\\node_modules\\cache-loader\\dist\\cjs.js","mtime":1788081846128},{"path":"D:\\blog\\node_modules\\vue-loader\\lib\\index.js","mtime":1788081851187}],"contextDependencies":[],"result":[{"type":"Buffer","data":"base64:"},{"version":3,"sources":["Tag.vue"],"names":[],"mappings":";AA2DA;AACA;AACA;AACA;AACA;;AAEA;AACA;AACA;;AAEA;AACA;AACA;AACA;;AAEA;AACA;AACA;AACA;;AAEA;AACA;AACA;AACA;;AAEA;AACA;AACA;;AAEA;AACA;AACA;AACA;;AAEA;AACA;AACA;AACA;;AAEA;AACA;AACA","file":"Tag.vue","sourceRoot":"docs/.vuepress/theme/layouts","sourcesContent":["<template>\r\n  <ParentLayout>\r\n    <template slot=\"page-top\">\r\n      <div class=\"tag-page\">\r\n        <h1>标签：{{ $page.title }}</h1>\r\n\r\n        <div v-for=\"post in $pagination.pages\" :key=\"post.path\" class=\"post-item\">\r\n          <h2>\r\n            <router-link :to=\"post.path\">\r\n              {{ post.title }}\r\n            </router-link>\r\n          </h2>\r\n\r\n          <p v-if=\"post.frontmatter.date\" class=\"post-date\">\r\n            {{ formatDate(post.frontmatter.date) }}\r\n          </p>\r\n\r\n          <p v-if=\"post.frontmatter.description\" class=\"post-description\">\r\n            {{ post.frontmatter.description }}\r\n          </p>\r\n\r\n          <router-link :to=\"post.path\" class=\"read-more\"> 阅读全文 → </router-link>\r\n        </div>\r\n      </div>\r\n    </template>\r\n  </ParentLayout>\r\n</template>\r\n\r\n<script>\r\nimport ParentLayout from '@parent-theme/layouts/Layout.vue'\r\n\r\nexport default {\r\n  components: {\r\n    ParentLayout,\r\n  },\r\n\r\n  methods: {\r\n    formatDate(date) {\r\n      if (!date) {\r\n        return ''\r\n      }\r\n\r\n      const d = new Date(date)\r\n\r\n      if (isNaN(d.getTime())) {\r\n        return date\r\n      }\r\n\r\n      const year = d.getFullYear()\r\n      const month = String(d.getMonth() + 1).padStart(2, '0')\r\n      const day = String(d.getDate()).padStart(2, '0')\r\n\r\n      return `${year}-${month}-${day}`\r\n    },\r\n  },\r\n}\r\n</script>\r\n\r\n<style scoped>\r\n.tag-page {\r\n  max-width: 900px;\r\n  margin: 0 auto;\r\n  padding: 60px 0 40px;\r\n}\r\n\r\n.tag-page h1 {\r\n  margin-bottom: 30px;\r\n}\r\n\r\n.post-item {\r\n  padding: 20px 0 25px;\r\n  border-bottom: 1px solid #eaecef;\r\n}\r\n\r\n.post-item h2 {\r\n  margin-top: 0;\r\n  margin-bottom: 15px;\r\n}\r\n\r\n.post-item h2 a {\r\n  color: #3eaf7c;\r\n  text-decoration: none;\r\n}\r\n\r\n.post-item h2 a:hover {\r\n  color: #2c3e50;\r\n}\r\n\r\n.post-date {\r\n  color: #999;\r\n  font-size: 14px;\r\n}\r\n\r\n.post-description {\r\n  color: #666;\r\n  line-height: 1.8;\r\n}\r\n\r\n.read-more {\r\n  font-size: 14px;\r\n}\r\n</style>\r\n"]}]}