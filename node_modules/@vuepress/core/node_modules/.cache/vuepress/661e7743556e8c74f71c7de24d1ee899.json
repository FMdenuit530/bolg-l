      position: relative;\r\n      }\r\n    `\r\n\r\n    document.head.appendChild(style)\r\n  }\r\n\r\n  function copyText(text) {\r\n    if (navigator.clipboard && window.isSecureContext) {\r\n      return navigator.clipboard.writeText(text)\r\n    }\r\n\r\n    return new Promise((resolve, reject) => {\r\n      const textarea = document.createElement('textarea')\r\n\r\n      textarea.value = text\r\n      textarea.style.position = 'fixed'\r\n      textarea.style.left = '-9999px'\r\n\r\n      document.body.appendChild(textarea)\r\n\r\n      textarea.focus()\r\n      textarea.select()\r\n\r\n      try {\r\n        document.execCommand('copy')\r\n        resolve()\r\n      } catch (error) {\r\n        reject(error)\r\n      }\r\n\r\n      document.body.removeChild(textarea)\r\n    })\r\n  }\r\n\r\n  function addCopyButtons() {\r\n    addCopyStyle()\r\n\r\n    const blocks = document.querySelectorAll('div[class*=\"language-\"]')\r\n\r\n    blocks.forEach((block) => {\r\n      if (block.querySelector('.copy-code-button')) {\r\n        return\r\n      }\r\n\r\n      const button = document.createElement('button')\r\n\r\n      button.className = 'copy-code-button'\r\n      button.type = 'button'\r\n      button.textContent = '复制'\r\n\r\n      button.addEventListener('click', () => {\r\n        const code = block.querySelector('code')\r\n\r\n        if (!code) {\r\n          return\r\n        }\r\n\r\n        copyText(code.innerText)\r\n          .then(() => {\r\n            button.textContent = '已复制'\r\n\r\n            setTimeout(() => {\r\n              button.textContent = '复制'\r\n            }, 1500)\r\n          })\r\n          .catch(() => {\r\n            button.textContent = '复制失败'\r\n\r\n            setTimeout(() => {\r\n              button.textContent = '复制'\r\n            }, 1500)\r\n          })\r\n      })\r\n\r\n      block.appendChild(button)\r\n    })\r\n  }\r\n\r\n  // 首次加载\r\n  router.onReady(() => {\r\n    setTimeout(addCopyButtons, 0)\r\n  })\r\n\r\n  // VuePress 页面切换后重新添加\r\n  router.afterEach(() => {\r\n    setTimeout(addCopyButtons, 0)\r\n  })\r\n}\r\n"],"mappings":";;AAAAA,MAAM,CAACC,OAAO,GAAG,CAAC;EAAEC;AAAO,CAAC,KAAK;EAC/B;EACA,IAAI,OAAOC,QAAQ,KAAK,WAAW,EAAE;IACnC;EACF;EAEA,SAASC,YAAYA,CAAA,EAAG;IACtB,IAAID,QAAQ,CAACE,cAAc,CAAC,iBAAiB,CAAC,EAAE;MAC9C;IACF;IAEA,MAAMC,KAAK,GAAGH,QAAQ,CAACI,aAAa,CAAC,OAAO,CAAC;IAE7CD,KAAK,CAACE,EAAE,GAAG,iBAAiB;IAE5BF,KAAK,CAACG,SAAS,GAAG;AACtB;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA,KAAK;IAEDN,QAAQ,CAACO,IAAI,CAACC,WAAW,CAACL,KAAK,CAAC;EAClC;EAEA,SAASM,QAAQA,CAACC,IAAI,EAAE;IACtB,IAAIC,SAAS,CAACC,SAAS,IAAIC,MAAM,CAACC,eAAe,EAAE;MACjD,OAAOH,SAAS,CAACC,SAAS,CAACG,SAAS,CAACL,IAAI,CAAC;IAC5C;IAEA,OAAO,IAAIM,OAAO,CAAC,CAACC,OAAO,EAAEC,MAAM,KAAK;MACtC,MAAMC,QAAQ,GAAGnB,QAAQ,CAACI,aAAa,CAAC,UAAU,CAAC;MAEnDe,QAAQ,CAACC,KAAK,GAAGV,IAAI;MACrBS,QAAQ,CAAChB,KAAK,CAACkB,QAAQ,GAAG,OAAO;MACjCF,QAAQ,CAAChB,KAAK,CAACmB,IAAI,GAAG,SAAS;MAE/BtB,QAAQ,CAACuB,IAAI,CAACf,WAAW,CAACW,QAAQ,CAAC;MAEnCA,QAAQ,CAACK,KAAK,CAAC,CAAC;MAChBL,QAAQ,CAACM,MAAM,CAAC,CAAC;MAEjB,IAAI;QACFzB,QAAQ,CAAC0B,WAAW,CAAC,MAAM,CAAC;QAC5BT,OAAO,CAAC,CAAC;MACX,CAAC,CAAC,OAAOU,KAAK,EAAE;QACdT,MAAM,CAACS,KAAK,CAAC;MACf;MAEA3B,QAAQ,CAACuB,IAAI,CAACK,WAAW,CAACT,QAAQ,CAAC;IACrC,CAAC,CAAC;EACJ;EAEA,SAASU,cAAcA,CAAA,EAAG;IACxB5B,YAAY,CAAC,CAAC;IAEd,MAAM6B,MAAM,GAAG9B,QAAQ,CAAC+B,gBAAgB,CAAC,yBAAyB,CAAC;IAEnED,MAAM,CAACE,OAAO,CAAEC,KAAK,IAAK;MACxB,IAAIA,KAAK,CAACC,aAAa,CAAC,mBAAmB,CAAC,EAAE;QAC5C;MACF;MAEA,MAAMC,MAAM,GAAGnC,QAAQ,CAACI,aAAa,CAAC,QAAQ,CAAC;MAE/C+B,MAAM,CAACC,SAAS,GAAG,kBAAkB;MACrCD,MAAM,CAACE,IAAI,GAAG,QAAQ;MACtBF,MAAM,CAACG,WAAW,GAAG,IAAI;MAEzBH,MAAM,CAACI,gBAAgB,CAAC,OAAO,EAAE,MAAM;QACrC,MAAMC,IAAI,GAAGP,KAAK,CAACC,aAAa,CAAC,MAAM,CAAC;QAExC,IAAI,CAACM,IAAI,EAAE;UACT;QACF;QAEA/B,QAAQ,CAAC+B,IAAI,CAACC,SAAS,CAAC,CACrBC,IAAI,CAAC,MAAM;UACVP,MAAM,CAACG,WAAW,GAAG,KAAK;UAE1BK,UAAU,CAAC,MAAM;YACfR,MAAM,CAACG,WAAW,GAAG,IAAI;UAC3B,CAAC,EAAE,IAAI,CAAC;QA