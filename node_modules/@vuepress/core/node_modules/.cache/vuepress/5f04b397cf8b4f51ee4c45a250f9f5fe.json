r\n      <router-link to=\"/\" class=\"custom-404-button\"> 返回首页 </router-link>\r\n    </div>\r\n  </div>\r\n</template>\r\n\r\n<script>\r\nexport default {\r\n  name: 'NotFound',\r\n}\r\n</script>\r\n\r\n<style scoped>\r\n/* =========================================================\r\n   404 页面\r\n   ========================================================= */\r\n\r\n.custom-404 {\r\n  position: relative;\r\n\r\n  min-height: calc(100vh - 60px);\r\n\r\n  display: flex;\r\n\r\n  align-items: center;\r\n\r\n  justify-content: center;\r\n\r\n  box-sizing: border-box;\r\n\r\n  padding: 60px 20px 80px;\r\n}\r\n\r\n.custom-404-inner {\r\n  width: 100%;\r\n\r\n  max-width: 760px;\r\n\r\n  margin: 0 auto;\r\n\r\n  box-sizing: border-box;\r\n\r\n  text-align: center;\r\n}\r\n\r\n/* =========================================================\r\n   404 数字\r\n   ========================================================= */\r\n\r\n.custom-404-code {\r\n  color: #e1e7e4;\r\n\r\n  font-size: 120px;\r\n\r\n  font-weight: 650;\r\n\r\n  line-height: 1;\r\n\r\n  letter-spacing: 0.04em;\r\n}\r\n\r\n/* =========================================================\r\n   绿色短线\r\n   ========================================================= */\r\n\r\n.custom-404-line {\r\n  width: 44px;\r\n\r\n  height: 2px;\r\n\r\n  margin: 24px auto 24px;\r\n\r\n  border-radius: 2px;\r\n\r\n  background: #3eaf7c;\r\n\r\n  opacity: 0.7;\r\n}\r\n\r\n/* =========================================================\r\n   标题\r\n   ========================================================= */\r\n\r\n.custom-404 h1 {\r\n  margin: 0;\r\n\r\n  color: #2c3e50;\r\n\r\n  font-size: 28px;\r\n\r\n  font-weight: 600;\r\n\r\n  line-height: 1.5;\r\n}\r\n\r\n/* =========================================================\r\n   描述\r\n   ========================================================= */\r\n\r\n.custom-404-description {\r\n  margin: 12px 0 0;\r\n\r\n  color: #999;\r\n\r\n  font-size: 14px;\r\n\r\n  line-height: 1.8;\r\n}\r\n\r\n/* =========================================================\r\n   返回首页\r\n   ========================================================= */\r\n\r\n.custom-404-button {\r\n  display: inline-flex;\r\n\r\n  align-items: center;\r\n\r\n  justify-content: center;\r\n\r\n  min-width: 98px;\r\n\r\n  height: 36px;\r\n\r\n  margin-top: 28px;\r\n\r\n  padding: 0 18px;\r\n\r\n  box-sizing: border-box;\r\n\r\n  border: 1px solid #dfe9e4;\r\n\r\n  border-radius: 18px;\r\n\r\n  background: #f7fbf9;\r\n\r\n  color: #3eaf7c;\r\n\r\n  font-size: 13px;\r\n\r\n  line-height: 1;\r\n\r\n  text-decoration: none;\r\n\r\n  transition: transform 0.2s ease, background 0.2s ease, border-color 0.2s ease, color 0.2s ease, box-shadow 0.2s ease;\r\n}\r\n\r\n.custom-404-button:hover {\r\n  transform: translateY(-2px);\r\n\r\n  border-color: #3eaf7c;\r\n\r\n  background: #3eaf7c;\r\n\r\n  color: #fff;\r\n\r\n  box-shadow: 0 6px 18px rgba(62, 175, 124, 0.1);\r\n\r\n  text-decoration: none;\r\n}\r\n\r\n/* =========================================================\r\n   手机\r\n   ========================================================= */\r\n\r\n@media (max-width: 719px) {\r\n  .custom-404 {\r\n    min-height: calc(100vh - 60px);\r\n\r\n    padding: 50px 18px 70px;\r\n  }\r\n\r\n  .custom-404-code {\r\n    font-size: 86px;\r\n  }\r\n\r\n  .custom-404-line {\r\n    margin-top: 20px;\r\n\r\n    margin-bottom: 20px;\r\n  }\r\n\r\n  .custom-404 h1 {\r\n    font-size: 23px;\r\n  }\r\n\r\n  .custom-404-description {\r\n    font-size: 13px;\r\n  }\r\n\r\n  .custom-404-button {\r\n    min-width: 92px;\r\n\r\n    height: 35px;\r\n\r\n    margin-top: 24px;\r\n\r\n    font-size: 12px;\r\n  }\r\n}\r\n</style>\r\n"]}]}