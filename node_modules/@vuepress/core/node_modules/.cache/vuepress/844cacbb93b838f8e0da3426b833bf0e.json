{"remainingRequest":"D:\\blog\\node_modules\\vue-loader\\lib\\index.js??vue-loader-options!D:\\blog\\docs\\.vuepress\\theme\\layouts\\About.vue?vue&type=script&lang=js","dependencies":[{"path":"D:\\blog\\docs\\.vuepress\\theme\\layouts\\About.vue","mtime":1789021523960},{"path":"D:\\blog\\node_modules\\cache-loader\\dist\\cjs.js","mtime":1788081846128},{"path":"D:\\blog\\node_modules\\babel-loader\\lib\\index.js","mtime":1788081850451},{"path":"D:\\blog\\node_modules\\cache-loader\\dist\\cjs.js","mtime":1788081846128},{"path":"D:\\blog\\node_modules\\vue-loader\\lib\\index.js","mtime":1788081851187}],"contextDependencies":[],"result":[{"type":"Buffer","data":"base64:DQppbXBvcnQgUGFyZW50TGF5b3V0IGZyb20gJ0BwYXJlbnQtdGhlbWUvbGF5b3V0cy9MYXlvdXQudnVlJw0KDQpleHBvcnQgZGVmYXVsdCB7DQogIG5hbWU6ICdBYm91dCcsDQoNCiAgY29tcG9uZW50czogew0KICAgIFBhcmVudExheW91dCwNCiAgfSwNCn0NCg=="},{"version":3,"sources":["About.vue"],"names":[],"mappings":";AAyJA;;AAEA;AACA;;AAEA;AACA;AACA;AACA","file":"About.vue","sourceRoot":"docs/.vuepress/theme/layouts","sourcesContent":["<template>\r\n  <ParentLayout>\r\n    <template slot=\"page-top\">\r\n      <main class=\"about-page\">\r\n        <!-- ========================================\r\n             顶部介绍\r\n             ======================================== -->\r\n\r\n        <section class=\"about-hero\">\r\n          <div class=\"about-eyebrow\">ABOUT ME</div>\r\n\r\n          <h1 class=\"about-title\">关于我</h1>\r\n\r\n          <p class=\"about-subtitle\">记录学习 · 分享技术 · 持续成长</p>\r\n\r\n          <p class=\"about-intro\">这里是我的个人技术博客。 我会把学习过程中的思考、实践和踩坑记录下来， 也希望通过持续整理，让知识真正沉淀下来。</p>\r\n        </section>\r\n\r\n        <!-- ========================================\r\n             博客介绍\r\n             ======================================== -->\r\n\r\n        <section class=\"about-section\">\r\n          <div class=\"about-section-label\">01</div>\r\n\r\n          <div class=\"about-section-content\">\r\n            <h2>关于这个博客</h2>\r\n\r\n            <p>这个博客主要用来记录日常学习和技术实践。 相比单纯收藏资料，我更希望把真正理解过、 使用过以及遇到过问题的内容整理下来。</p>\r\n\r\n            <p>从 JavaScript、Vue，到 Git 以及各种开发过程中的小问题， 都会慢慢沉淀在这里。</p>\r\n          </div>\r\n        </section>\r\n\r\n        <!-- ========================================\r\n             技术方向\r\n             ======================================== -->\r\n\r\n        <section class=\"about-section\">\r\n          <div class=\"about-section-label\">02</div>\r\n\r\n          <div class=\"about-section-content\">\r\n            <h2>技术方向</h2>\r\n\r\n            <div class=\"about-tech-list\">\r\n              <div class=\"about-tech-item\">\r\n                <div class=\"about-tech-name\">JavaScript</div>\r\n\r\n                <div class=\"about-tech-description\">语言基础、异步编程、Promise、闭包以及日常开发中的实践。</div>\r\n              </div>\r\n\r\n              <div class=\"about-tech-item\">\r\n                <div class=\"about-tech-name\">Vue</div>\r\n\r\n                <div class=\"about-tech-description\">Vue 3、Composition API、响应式以及现代前端项目开发。</div>\r\n              </div>\r\n\r\n              <div class=\"about-tech-item\">\r\n                <div class=\"about-tech-name\">Git</div>\r\n\r\n                <div class=\"about-tech-description\">日常开发中的版本管理、提交、分支以及项目部署。</div>\r\n              </div>\r\n\r\n              <div class=\"about-tech-item\">\r\n                <div class=\"about-tech-name\">VuePress</div>\r\n\r\n                <div class=\"about-tech-description\">使用 VuePress 搭建个人博客，并持续优化博客体验。</div>\r\n              </div>\r\n            </div>\r\n          </div>\r\n        </section>\r\n\r\n        <!-- ========================================\r\n             为什么写博客\r\n             ======================================== -->\r\n\r\n        <section class=\"about-section\">\r\n          <div class=\"about-section-label\">03</div>\r\n\r\n          <div class=\"about-section-content\">\r\n            <h2>为什么写博客</h2>\r\n\r\n            <p>学习的时候，经常会遇到一些看起来很简单， 但真正动手之后才发现并没有想象中那么简单的问题。</p>\r\n\r\n            <p>把这些问题重新整理一次， 往往也是再次理解它们的过程。</p>\r\n\r\n            <p>所以这里不只是一个文章展示页面， 更像是一份属于自己的长期技术笔记。</p>\r\n          </div>\r\n        </section>\r\n\r\n        <!-- ========================================\r\n             当前状态\r\n             ======================================== -->\r\n\r\n        <section class=\"about-section\">\r\n          <div class=\"about-section-label\">04</div>\r\n\r\n          <div class=\"about-section-content\">\r\n            <h2>正在进行</h2>\r\n\r\n            <div class=\"about-status\">\r\n              <div class=\"about-status-row\">\r\n                <span class=\"about-status-name\"> Blog </span>\r\n\r\n                <span class=\"about-status-value\"> 持续建设中 </span>\r\n              </div>\r\n\r\n              <div class=\"about-status-row\">\r\n                <span class=\"about-status-name\"> Learning </span>\r\n\r\n                <span class=\"about-status-value\"> 持续学习中 </span>\r\n              </div>\r\n\r\n              <div class=\"about-status-row\">\r\n                <span class=\"about-status-name\"> Writing </span>\r\n\r\n                <span class=\"about-status-value\"> 持续记录中 </span>\r\n              </div>\r\n            </div>\r\n          </div>\r\n        </section>\r\n\r\n        <!-- ========================================\r\n             GitHub\r\n             ======================================== -->\r\n\r\n        <section class=\"about-contact\">\r\n          <div class=\"about-contact-inner\">\r\n            <div class=\"about-contact-label\">PROJECT</div>\r\n\r\n            <h2>我的 GitHub</h2>\r\n\r\n            <p>博客源码、配置以及后续项目都会继续放在 GitHub。</p>\r\n\r\n            <a class=\"about-github\" href=\"https://github.com/FMdenuit530/bolg-l\" target=\"_blank\" rel=\"noopener noreferrer\">\r\n              <span> github.com/FMdenuit530/bolg-l </span>\r\n\r\n              <span class=\"about-github-arrow\"> ↗ </span>\r\n            </a>\r\n          </div>\r\n        </section>\r\n\r\n        <!-- ========================================\r\n             底部文字\r\n             ======================================== -->\r\n\r\n        <div class=\"about-footer-note\">慢一点没关系，重要的是一直在前进。</div>\r\n      </main>\r\n    </template>\r\n  </ParentLayout>\r\n</template>\r\n\r\n<script>\r\nimport ParentLayout from '@parent-theme/layouts/Layout.vue'\r\n\r\nexport default {\r\n  name: 'About',\r\n\r\n  components: {\r\n    ParentLayout,\r\n  },\r\n}\r\n</script>\r\n\r\n<style scoped>\r\n/* ============================================================\r\n * 页面\r\n * ============================================================ */\r\n\r\n.about-page {\r\n  width: 100%;\r\n\r\n  max-width: 880px;\r\n\r\n  margin: 0 auto;\r\n\r\n  padding: 34px 20px 72px;\r\n\r\n  box-sizing: border-box;\r\n\r\n  color: #2c3e50;\r\n}\r\n\r\n/* ============================================================\r\n * 顶部\r\n * ============================================================ */\r\n\r\n.about-hero {\r\n  padding: 0;\r\n\r\n  text-align: left;\r\n}\r\n\r\n.about-eyebrow {\r\n  margin-bottom: 10px;\r\n\r\n  color: #9aa6a0;\r\n\r\n  font-size: 12px;\r\n\r\n  line-height: 1.6;\r\n\r\n  letter-spacing: 0.12em;\r\n}\r\n\r\n.about-title {\r\n  margin: 0;\r\n\r\n  padding: 0;\r\n\r\n  color: #2c3e50;\r\n\r\n  font-size: 40px;\r\n\r\n  font-weight: 650;\r\n\r\n  line-height: 1.25;\r\n\r\n  letter-spacing: -0.025em;\r\n}\r\n\r\n.about-subtitle {\r\n  margin: 12px 0 0;\r\n\r\n  color: #6f7c75;\r\n\r\n  font-size: 16px;\r\n\r\n  line-height: 1.8;\r\n}\r\n\r\n.about-intro {\r\n  max-width: 680px;\r\n\r\n  margin: 20px 0 0;\r\n\r\n  color: #788186;\r\n\r\n  font-size: 14px;\r\n\r\n  line-height: 2;\r\n}\r\n\r\n/* ============================================================\r\n * 普通区块\r\n * ============================================================ */\r\n\r\n.about-section {\r\n  display: grid;\r\n\r\n  grid-template-columns: 55px minmax(0, 1fr);\r\n\r\n  gap: 10px;\r\n\r\n  margin-top: 58px;\r\n\r\n  pa