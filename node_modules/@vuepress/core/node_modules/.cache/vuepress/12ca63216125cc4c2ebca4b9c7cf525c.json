{"remainingRequest":"D:\\blog\\node_modules\\babel-loader\\lib\\index.js??ref--3-1!D:\\blog\\node_modules\\cache-loader\\dist\\cjs.js??ref--0-0!D:\\blog\\node_modules\\vue-loader\\lib\\index.js??vue-loader-options!D:\\blog\\docs\\.vuepress\\theme\\layouts\\IndexPost.vue?vue&type=script&lang=js","dependencies":[{"path":"D:\\blog\\docs\\.vuepress\\theme\\layouts\\IndexPost.vue","mtime":1788969232267},{"path":"D:\\blog\\node_modules\\cache-loader\\dist\\cjs.js","mtime":1788081846128},{"path":"D:\\blog\\node_modules\\babel-loader\\lib\\index.js","mtime":1788081850451},{"path":"D:\\blog\\node_modules\\cache-loader\\dist\\cjs.js","mtime":1788081846128},{"path":"D:\\blog\\node_modules\\vue-loader\\lib\\index.js","mtime":1788081851187}],"contextDependencies":[],"result":[{"type":"Buffer","data":"base64:"},{"version":3,"names":["ParentLayout","name","components","computed","currentPage","$route","path","test","methods","formatDate","date","d","Date","isNaN","getTime","year","getFullYear","month","String","getMonth","padStart","day","getDate","getCategoryPath","category","encodeURIComponent","trim","normalizeTagName","value","decodePathValue","text","decodeURIComponent","error","getTagPath","tag","target","pages","Array","isArray","$site","tagPages","filter","page","startsWith","clean","replace","indexOf","pathMatch","find","pageTag","titleMatch","title","frontmatter","getTagHref","base","normalizedTags","tags"],"sources":["D:/blog/docs/.vuepress/theme/layouts/IndexPost.vue"],"sourcesContent":["\r\nimport ParentLayout from '@parent-theme/layouts/Layout.vue'\r\n\r\nexport default {\r\n  name: 'IndexPost',\r\n\r\n  components: {\r\n    ParentLayout,\r\n  },\r\n\r\n  computed: {\r\n    /* ==================================================\r\n       当前页码\r\n\r\n       /\r\n       /page/2/\r\n\r\n       目前博客只有两页，\r\n       所以这里保持简单稳定。\r\n       ================================================== */\r\n\r\n    currentPage() {\r\n      if (this.$route && this.$route.path === '/') {\r\n        return 1\r\n      }\r\n\r\n      if (this.$route && /^\\/page\\/2\\/?$/.test(this.$route.path)) {\r\n        return 2\r\n      }\r\n\r\n      return 1\r\n    },\r\n  },\r\n\r\n  methods: {\r\n    /* ==================================================\r\n       日期\r\n       ================================================== */\r\n\r\n    formatDate(date) {\r\n      if (!date) {\r\n        return ''\r\n      }\r\n\r\n      const d = new Date(date)\r\n\r\n      if (isNaN(d.getTime())) {\r\n        return date\r\n      }\r\n\r\n      const year = d.getFullYear()\r\n\r\n      const month = String(d.getMonth() + 1).padStart(2, '0')\r\n\r\n      const day = String(d.getDate()).padStart(2, '0')\r\n\r\n      return `${year}-${month}-${day}`\r\n    },\r\n\r\n    /* ==================================================\r\n       分类路径\r\n       ================================================== */\r\n\r\n    getCategoryPath(category) {\r\n      return `/category/${encodeURIComponent(String(category).trim())}/`\r\n    },\r\n\r\n    /* ==================================================\r\n       标签名称标准化\r\n       ================================================== */\r\n\r\n    normalizeTagName(value) {\r\n      return String(value == null ? '' : value).trim()\r\n    },\r\n\r\n    /* ==================================================\r\n       URL 解码\r\n       ================================================== */\r\n\r\n    decodePathValue(value) {\r\n      const text = String(value == null ? '' : value)\r\n\r\n      try {\r\n        return decodeURIComponent(text)\r\n      } catch (error) {\r\n        return text\r\n      }\r\n    },\r\n\r\n    /* ==================================================\r\n       查找真实标签页面\r\n       ================================================== */\r\n\r\n    getTagPath(tag) {\r\n      const target = this.normalizeTagName(tag)\r\n\r\n      if (!target) {\r\n        return '/tags/'\r\n      }\r\n\r\n      const pages = Array.isArray(this.$site.pages) ? this.$site.pages : []\r\n\r\n      const tagPages = pages.filter((page) => {\r\n        if (!page || !page.path) {\r\n          return false\r\n        }\r\n\r\n        const path = String(page.path)\r\n\r\n        if (!path.startsWith('/tags/')) {\r\n          return false\r\n        }\r\n\r\n        if (path === '/tags/' || path === '/tags') {\r\n          return false\r\n        }\r\n\r\n        const clean = path.replace(/^\\/tags\\//, '').replace(/\\/$/, '')\r\n\r\n        return clean && clean.indexOf('/') === -1\r\n      })\r\n\r\n      /*\r\n       * 按真实 URL 比较\r\n       */\r\n\r\n      const pathMatch = tagPages.find((page) => {\r\n        const clean = String(page.path)\r\n          .replace(/^\\/tags\\//, '')\r\n          .replace(/\\/$/, '')\r\n\r\n        const pageTag = this.decodePathValue(clean)\r\n\r\n        return pageTag === target\r\n      })\r\n\r\n      if (pathMatch && pathMatch.path) {\r\n        return pathMatch.path\r\n      }\r\n\r\n      /*\r\n       * 再按页面标题比较\r\n       */\r\n\r\n      const titleMatch = tagPages.find((page) => {\r\n        const title = page.title || (page.frontmatter && page.frontmatter.title) || ''\r\n\r\n        return this.normalizeTagName(title) === target\r\n      })\r\n\r\n      if (titleMatch && titleMatch.path) {\r\n        return titleMatch.path\r\n      }\r\n\r\n      /*\r\n       * 最终兜底\r\n       */\r\n\r\n      return `/tags/${encodeURIComponent(target)}/`\r\n    },\r\n\r\n    /* ==================================================\r\n       完整 href\r\n\r\n       当前项目 base：\r\n       /bolg-l/\r\n       ================================================== */\r\n\r\n    getTagHref(tag) {\r\n      const path = this.getTagPath(tag)\r\n\r\n      const base = this.$site && this.$site.base ? this.$site.base : '/'\r\n\r\n      return base.replace(/\\/$/, '') + '/' + path.replace(/^\\//, '')\r\n    },\r\n\r\n    /* ==================================================\r\n       tags 标准化\r\n       ================================================== */\r\n\r\n    normalizedTags(tags) {\r\n      if (!tags) {\r\n        return []\r\n      }\r\n\r\n      if (Array.isArray(tags)) {\r\n        return tags\r\n      }\r\n\r\n      return [tags]\r\n    },\r\n  },\r\n}\r\n"],"mappings":";;;AACA,OAAOA,YAAY,MAAM,kCAAkC;AAE3D,eAAe;EACbC,IAAI,EAAE,WAAW;EAEjBC,UAAU,EAAE;IACVF;EACF,CAAC;EAEDG,QAAQ,EAAE;IACR;AACJ;AACA;AACA;AACA;AACA;AACA;;IAIIC,WAAWA,CAAA,EAAG;MACZ,IAAI,IAAI,CAACC,MAAM,IAAI,IAAI,CAACA,MAAM,CAACC,IAAI,KAAK,GAAG,EAAE;QAC3C,OAAO,CAAC;MACV;MAEA,IAAI,IAAI,CAACD,MAAM,IAAI,gBAAgB,CAACE,IAAI,CAAC,IAAI,CAACF,MAAM,CAACC,IAAI,CAAC,EAAE;QAC1D,OAAO,CAAC;MACV;MAEA,OAAO,CAAC;IACV;EACF,CAAC;EAEDE,OAAO,EAAE;IACP;AACJ;AACA;;IAEIC,UAAUA,CAACC,IAAI,EAAE;MACf,IAAI,CAACA,IAAI,EAAE;QACT,OAAO,EAAE;MACX;MAEA,MAAMC,CAAC,GAAG,IAAIC,IAAI,CAACF,IAAI,CAAC;MAExB,IAAIG,KAAK,CAACF,CAAC,CAACG,OAAO,CAAC,CAAC,CAAC,EAAE;QACtB,OAAOJ,IAAI;MACb;MAEA,MAAMK,IAAI,GAAGJ,CAAC,CAACK,WAAW,CAAC,CAAC;MAE5B,MAAMC,KAAK,GAAGC,MAAM,CAACP,CAAC,CAACQ,QAAQ,CAAC,CAAC,GAAG,CAAC,CAAC,CAACC,QAAQ,CAAC,CAAC,EAAE,GAAG,CAAC;MAEvD,MAAMC,GAAG,GAAGH,MAAM,CAACP,CAAC,CAACW,OAAO,CAAC,CAAC,CAAC,CAACF,QAAQ,CAAC,CAAC,EAAE,GAAG,CAAC;MAEhD,OAAO,GAAGL,IAAI,IAAIE,KAAK,IAAII,GAAG,EAAE;IAClC,CAAC;IAED;AACJ;AACA;;IAEIE,eAAeA,CAACC,QAAQ,EAAE;MACxB,OAAO,aAAaC,kBAAkB,CAACP,MAAM,CAACM,QAAQ,CAAC,CAACE,IAAI,CAAC,CAAC,CAAC,GAAG;IACpE,CAAC;IAED;AACJ;AACA;;IAEIC,gBAAgBA,CAACC,KAAK,EAAE;MACtB,OAAOV,MAAM,CAACU,KAAK,IAAI,IAAI,GAAG,EAAE,GAAGA,KAAK,CAAC,CAACF,IAAI,CAAC,CAAC;IAClD,CAAC;IAED;AACJ;AACA;;IAEIG,eAAeA,CAACD,KAAK,EAAE;MACrB,MAAME,IAAI,GAAGZ,MAAM,CAACU,KAAK,IAAI,IAAI,GAAG,EAAE,GAAGA,KAAK,CAAC;MAE/C,IAAI;QACF,OAAOG,kBAAkB,CAACD,IAAI,CAAC;MACjC,CAAC,CAAC,OAAOE,KAAK,EAAE;QACd,OAAOF,IAAI;MACb;IACF,CAAC;IAED;AACJ;AACA;;IAEIG,UAAUA,CAACC,GAAG,EAAE;MACd,MAAMC,MAAM,GAAG,IAAI,CAACR,gBAAgB,CAACO,GAAG,CAAC;MAEzC,IAAI,CAACC,MAAM,EAAE;QACX,OAAO,QAAQ;MACjB;MAEA,MAAMC,KAAK,GAAGC,KAAK,CAACC,OAAO,CAAC,IAAI,CAACC,KAAK,CAACH,KAAK,CAAC,GAAG,IAAI,CAACG,KAAK,CAACH,KAAK,GAAG,EAAE;M