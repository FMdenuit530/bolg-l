e slot=\"page-top\">\r\n      <!-- =========================\r\n           分类页面\r\n           ========================= -->\r\n\r\n      <section class=\"category-page\">\r\n        <div class=\"category-inner\">\r\n          <!-- 页面标题 -->\r\n\r\n          <div class=\"category-header\">\r\n            <div class=\"category-kicker\">CATEGORY</div>\r\n\r\n            <h1>文章分类</h1>\r\n\r\n            <p>按主题浏览我的文章</p>\r\n          </div>\r\n\r\n          <!-- =========================\r\n               分类列表\r\n               ========================= -->\r\n\r\n          <div v-if=\"$frontmatterKey && $frontmatterKey.list\" class=\"category-list\">\r\n            <router-link v-for=\"category in $frontmatterKey.list\" :key=\"category.name\" :to=\"category.path\" class=\"category-item\">\r\n              <div class=\"category-item-left\">\r\n                <div class=\"category-name\">\r\n                  {{ category.name }}\r\n                </div>\r\n\r\n                <div class=\"category-description\">浏览 {{ category.pages.length }} 篇文章</div>\r\n              </div>\r\n\r\n              <div class=\"category-item-right\">\r\n                <span class=\"category-count\">\r\n                  {{ category.pages.length }}\r\n                </span>\r\n\r\n                <span class=\"category-arrow\"> → </span>\r\n              </div>\r\n            </router-link>\r\n          </div>\r\n\r\n          <!-- 没有分类 -->\r\n\r\n          <div v-else class=\"category-empty\">暂无文章分类</div>\r\n        </div>\r\n      </section>\r\n    </template>\r\n  </ParentLayout>\r\n</template>\r\n\r\n<script>\r\nimport ParentLayout from '@parent-theme/layouts/Layout.vue'\r\n\r\nexport default {\r\n  name: 'Category',\r\n\r\n  components: {\r\n    ParentLayout,\r\n  },\r\n}\r\n</script>\r\n\r\n<style scoped>\r\n/* =========================\r\n   整体\r\n   ========================= */\r\n\r\n.category-page {\r\n  width: 100%;\r\n\r\n  box-sizing: border-box;\r\n}\r\n\r\n.category-inner {\r\n  max-width: 900px;\r\n\r\n  margin: 0 auto;\r\n\r\n  padding: 100px 30px 80px;\r\n\r\n  box-sizing: border-box;\r\n}\r\n\r\n/* =========================\r\n   页面标题\r\n   ========================= */\r\n\r\n.category-header {\r\n  margin-bottom: 45px;\r\n}\r\n\r\n.category-kicker {\r\n  margin-bottom: 15px;\r\n\r\n  color: #aaa;\r\n\r\n  font-size: 12px;\r\n\r\n  font-weight: 600;\r\n\r\n  letter-spacing: 0.18em;\r\n}\r\n\r\n.category-header h1 {\r\n  margin: 0;\r\n\r\n  color: #2c3e50;\r\n\r\n  font-size: 2.5rem;\r\n\r\n  font-weight: 700;\r\n\r\n  line-height: 1.3;\r\n}\r\n\r\n.category-header p {\r\n  margin: 12px 0 0;\r\n\r\n  color: #999;\r\n\r\n  font-size: 14px;\r\n\r\n  line-height: 1.7;\r\n}\r\n\r\n/* =========================\r\n   分类列表\r\n   ========================= */\r\n\r\n.category-list {\r\n  display: flex;\r\n\r\n  flex-direction: column;\r\n\r\n  border-top: 1px solid #eeeeee;\r\n}\r\n\r\n/* =========================\r\n   分类项目\r\n   ========================= */\r\n\r\n.category-item {\r\n  position: relative;\r\n\r\n  display: flex;\r\n\r\n  align-items: center;\r\n\r\n  justify-content: space-between;\r\n\r\n  gap: 20px;\r\n\r\n  padding: 24px 10px;\r\n\r\n  border-bottom: 1px solid #eeeeee;\r\n\r\n  color: inherit;\r\n\r\n  text-decoration: none;\r\n\r\n  transition: padding-left 0.2s ease, background 0.2s ease;\r\n}\r\n\r\n.category-item::before {\r\n  content: '';\r\n\r\n  position: absolute;\r\n\r\n  left: -1px;\r\n\r\n  top: 0;\r\n\r\n  width: 2px;\r\n\r\n  height: 0;\r\n\r\n  background: #3eaf7c;\r\n\r\n  transition: height 0.2s ease;\r\n}\r\n\r\n.category-item:hover {\r\n  padding-left: 18px;\r\n\r\n  background: #fafcfb;\r\n\r\n  text-decoration: none;\r\n}\r\n\r\n.category-item:hover::before {\r\n  height: 100%;\r\n}\r\n\r\n/* =========================\r\n   左侧\r\n   ========================= */\r\n\r\n.category-item-left {\r\n  min-width: 0;\r\n}\r\n\r\n.category-name {\r\n  color: #2c3e50;\r\n\r\n  font-size: 19px;\r\n\r\n  font-weight: 600;\r\n\r\n  line-height: 1.5;\r\n\r\n  transition: color 0.2s ease;\r\n}\r\n\r\n.category-item:hover .category-name {\r\n  color: #3eaf7c;\r\n}\r\n\r\n.category-description {\r\n  margin-top: 5px;\r\n\r\n  color: #aaa;\r\n\r\n  font-size: 12px;\r\n\r\n  line-height: 1.6;\r\n}\r\n\r\n/* =========================\r\n   右侧\r\n   ========================= */\r\n\r\n.category-item-right {\r\n  display: flex;\r\n\r\n  align-items: center;\r\n\r\n  gap: 10px;\r\n\r\n  flex-shrink: 0;\r\n}\r\n\r\n.category-count {\r\n  display: inline-flex;\r\n\r\n  align-items: center;\r\n\r\n  justify-content: center;\r\n\r\n  min-width: 28px;\r\n\r\n  height: 28px;\r\n\r\n  padding: 0 8px;\r\n\r\n  border-radius: 14px;\r\n\r\n  background: #f5f7f6;\r\n\r\n  color: #999;\r\n\r\n  font-size: 12px;\r\n\r\n  box-sizing: border-box;\r\n}\r\n\r\n.category-arrow {\r\n  color: #aaa;\r\n\r\n  font-size: 16px;\r\n\r\n  transition: color 0.2s ease, transform 0.2s ease;\r\n}\r\n\r\n.category-item:hover .category-arrow {\r\n  color: #3eaf7c;\r\n\r\n  transform: translateX(3px);\r\n}\r\n\r\n/* =========================\r\n   空状态\r\n   ========================= */\r\n\r\n.category-empty {\r\n  padding: 40px 0;\r\n\r\n  color: #999;\r\n\r\n  font-size: 14px;\r\n\r\n  text-align: center;\r\n}\r\n\r\n/* =========================\r\n   手机\r\n   ========================= */\r\n\r\n@media (max-width: 719px) {\r\n  .category-inner {\r\n    padding: 82px 18px 55px;\r\n  }\r\n\r\n  .category-header {\r\n    margin-bottom: 30px;\r\n  }\r\n\r\n  .category-header h1 {\r\n    font-size: 2rem;\r\n  }\r\n\r\n  .category-item {\r\n    padding: 21px 6px;\r\n  }\r\n\r\n  .category-item:hover {\r\n    padding-left: 10px;\r\n  }\r\n\r\n  .category-name {\r\n    font-size: 17px;\r\n  }\r\n\r\n  .category-description {\r\n    font-size: 11px;\r\n  }\r\n\r\n  .category-count {\r\n    min-width: 26px;\r\n\r\n    height: 26px;\r\n\r\n    padding: 0 7px;\r\n\r\n    border-radius: 13px;\r\n  }\r\n\r\n  .category-arrow {\r\n    font-size: 15px;\r\n  }\r\n}\r\n</style>\r\n"]}]}