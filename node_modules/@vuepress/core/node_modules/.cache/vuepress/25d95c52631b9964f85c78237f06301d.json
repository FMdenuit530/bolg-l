{"remainingRequest":"D:\\blog\\node_modules\\babel-loader\\lib\\index.js??ref--3-1!D:\\blog\\node_modules\\cache-loader\\dist\\cjs.js??ref--0-0!D:\\blog\\node_modules\\vue-loader\\lib\\index.js??vue-loader-options!D:\\blog\\docs\\.vuepress\\theme\\layouts\\CategoryList.vue?vue&type=script&lang=js","dependencies":[{"path":"D:\\blog\\docs\\.vuepress\\theme\\layouts\\CategoryList.vue","mtime":1789021339895},{"path":"D:\\blog\\node_modules\\cache-loader\\dist\\cjs.js","mtime":1788081846128},{"path":"D:\\blog\\node_modules\\babel-loader\\lib\\index.js","mtime":1788081850451},{"path":"D:\\blog\\node_modules\\cache-loader\\dist\\cjs.js","mtime":1788081846128},{"path":"D:\\blog\\node_modules\\vue-loader\\lib\\index.js","mtime":1788081851187}],"contextDependencies":[],"result":[{"type":"Buffer","data":"base64:"},{"version":3,"names":["ParentLayout","name","components","computed","categoryName","pageTitle","$page","title","path","$route","match","decodeURIComponent","e","articleList","$pagination","Array","isArray","pages","filter","page","frontmatter","date","slice","sort","a","b","dateA","Date","getTime","dateB","String","localeCompare","paginationVisible","hasPrev","hasNext","currentPage","pageNumber","methods","formatDate","d","isNaN","year","getFullYear","month","getMonth","padStart","day","getDate","getPostTags","post","tags","tag","getTagPath","value","trim"],"sources":["D:/blog/docs/.vuepress/theme/layouts/CategoryList.vue"],"sourcesContent":["\r\nimport ParentLayout from '@parent-theme/layouts/Layout.vue'\r\n\r\nexport default {\r\n  name: 'CategoryList',\r\n\r\n  components: {\r\n    ParentLayout,\r\n  },\r\n\r\n  computed: {\r\n    /* ========================================\r\n     * 当前分类名称\r\n     * ======================================== */\r\n    categoryName() {\r\n      const pageTitle = this.$page && this.$page.title\r\n\r\n      if (pageTitle) {\r\n        return pageTitle\r\n      }\r\n\r\n      const path = this.$route && this.$route.path ? this.$route.path : ''\r\n\r\n      const match = path.match(/^\\/category\\/(.+?)\\/?$/)\r\n\r\n      if (match && match[1]) {\r\n        try {\r\n          return decodeURIComponent(match[1])\r\n        } catch (e) {\r\n          return match[1]\r\n        }\r\n      }\r\n\r\n      return '分类'\r\n    },\r\n\r\n    /* ========================================\r\n     * 当前分类文章\r\n     * ======================================== */\r\n    articleList() {\r\n      if (!this.$pagination || !Array.isArray(this.$pagination.pages)) {\r\n        return []\r\n      }\r\n\r\n      return this.$pagination.pages\r\n        .filter((page) => {\r\n          return page && page.frontmatter && page.frontmatter.date\r\n        })\r\n        .slice()\r\n        .sort((a, b) => {\r\n          const dateA = new Date(a.frontmatter.date).getTime()\r\n\r\n          const dateB = new Date(b.frontmatter.date).getTime()\r\n\r\n          if (dateA === dateB) {\r\n            return String(a.path).localeCompare(String(b.path))\r\n          }\r\n\r\n          return dateB - dateA\r\n        })\r\n    },\r\n\r\n    /* ========================================\r\n     * 是否显示分页\r\n     * ======================================== */\r\n    paginationVisible() {\r\n      return !!(this.$pagination && (this.$pagination.hasPrev || this.$pagination.hasNext))\r\n    },\r\n\r\n    /* ========================================\r\n     * 当前页码\r\n     * ======================================== */\r\n    currentPage() {\r\n      if (!this.$pagination || !this.$pagination.pageNumber) {\r\n        return 1\r\n      }\r\n\r\n      return this.$pagination.pageNumber\r\n    },\r\n  },\r\n\r\n  methods: {\r\n    /* ========================================\r\n     * 日期\r\n     * ======================================== */\r\n    formatDate(date) {\r\n      if (!date) {\r\n        return ''\r\n      }\r\n\r\n      const d = new Date(date)\r\n\r\n      if (isNaN(d.getTime())) {\r\n        return date\r\n      }\r\n\r\n      const year = d.getFullYear()\r\n\r\n      const month = String(d.getMonth() + 1).padStart(2, '0')\r\n\r\n      const day = String(d.getDate()).padStart(2, '0')\r\n\r\n      return `${year}-${month}-${day}`\r\n    },\r\n\r\n    /* ========================================\r\n     * 获取文章标签\r\n     * ======================================== */\r\n    getPostTags(post) {\r\n      if (!post || !post.frontmatter) {\r\n        return []\r\n      }\r\n\r\n      const tags = post.frontmatter.tags\r\n\r\n      if (Array.isArray(tags)) {\r\n        return tags\r\n      }\r\n\r\n      if (typeof tags === 'string') {\r\n        return [tags]\r\n      }\r\n\r\n      const tag = post.frontmatter.tag\r\n\r\n      if (Array.isArray(tag)) {\r\n        return tag\r\n      }\r\n\r\n      if (typeof tag === 'string') {\r\n        return [tag]\r\n      }\r\n\r\n      return []\r\n    },\r\n\r\n    /* ========================================\r\n     * 标签地址\r\n     *\r\n     * 和刚刚修好的 Tag.vue\r\n     * 保持完全一致。\r\n     * ======================================== */\r\n    getTagPath(tag) {\r\n      const value = String(tag == null ? '' : tag).trim()\r\n\r\n      if (!value) {\r\n        return '/tags/'\r\n      }\r\n\r\n      return `/tags/${value}/`\r\n    },\r\n  },\r\n}\r\n"],"mappings":";;AACA,OAAOA,YAAY,MAAM,kCAAkC;AAE3D,eAAe;EACbC,IAAI,EAAE,cAAc;EAEpBC,UAAU,EAAE;IACVF;EACF,CAAC;EAEDG,QAAQ,EAAE;IACR;AACJ;AACA;IACIC,YAAYA,CAAA,EAAG;MACb,MAAMC,SAAS,GAAG,IAAI,CAACC,KAAK,IAAI,IAAI,CAACA,KAAK,CAACC,KAAK;MAEhD,IAAIF,SAAS,EAAE;QACb,OAAOA,SAAS;MAClB;MAEA,MAAMG,IAAI,GAAG,IAAI,CAACC,MAAM,IAAI,IAAI,CAACA,MAAM,CAACD,IAAI,GAAG,IAAI,CAACC,MAAM,CAACD,IAAI,GAAG,EAAE;MAEpE,MAAME,KAAK,GAAGF,IAAI,CAACE,KAAK,CAAC,wBAAwB,CAAC;MAElD,IAAIA,KAAK,IAAIA,KAAK,CAAC,CAAC,CAAC,EAAE;QACrB,IAAI;UACF,OAAOC,kBAAkB,CAACD,KAAK,CAAC,CAAC,CAAC,CAAC;QACrC,CAAC,CAAC,OAAOE,CAAC,EAAE;UACV,OAAOF,KAAK,CAAC,CAAC,CAAC;QACjB;MACF;MAEA,OAAO,IAAI;IACb,CAAC;IAED;AACJ;AACA;IACIG,WAAWA,CAAA,EAAG;MACZ,IAAI,CAAC,IAAI,CAACC,WAAW,IAAI,CAACC,KAAK,CAACC,OA