\r\nexport default {\r\n  components: {\r\n    ParentLayout,\r\n  },\r\n\r\n  methods: {\r\n    formatDate(date) {\r\n      if (!date) {\r\n        return ''\r\n      }\r\n\r\n      const d = new Date(date)\r\n\r\n      if (isNaN(d.getTime())) {\r\n        return date\r\n      }\r\n\r\n      const year = d.getFullYear()\r\n      const month = String(d.getMonth() + 1).padStart(2, '0')\r\n      const day = String(d.getDate()).padStart(2, '0')\r\n\r\n      return `${year}-${month}-${day}`\r\n    },\r\n  },\r\n}\r\n</script>\r\n\r\n<style scoped>\r\n.tag-page {\r\n  max-width: 900px;\r\n  margin: 0 auto;\r\n  padding: 60px 0 40px;\r\n}\r\n\r\n.tag-page h1 {\r\n  margin-bottom: 30px;\r\n}\r\n\r\n.post-item {\r\n  padding: 20px 0 25px;\r\n  border-bottom: 1px solid #eaecef;\r\n}\r\n\r\n.post-item h2 {\r\n  margin-top: 0;\r\n  margin-bottom: 15px;\r\n}\r\n\r\n.post-item h2 a {\r\n  color: #3eaf7c;\r\n  text-decoration: none;\r\n}\r\n\r\n.post-item h2 a:hover {\r\n  color: #2c3e50;\r\n}\r\n\r\n.post-date {\r\n  color: #999;\r\n  font-size: 14px;\r\n}\r\n\r\n.post-description {\r\n  color: #666;\r\n  line-height: 1.8;\r\n}\r\n\r\n.read-more {\r\n  font-size: 14px;\r\n}\r\n</style>\r\n"],"mappings":"AA6BA,OAAAA,YAAA;AAEA;EACAC,UAAA;IACAD;EACA;EAEAE,OAAA;IACAC,WAAAC,IAAA;MACA,KAAAA,IAAA;QACA;MACA;MAEA,MAAAC,CAAA,OAAAC,IAAA,CAAAF,IAAA;MAEA,IAAAG,KAAA,CAAAF,CAAA,CAAAG,OAAA;QACA,OAAAJ,IAAA;MACA;MAEA,MAAAK,IAAA,GAAAJ,CAAA,CAAAK,WAAA;MACA,MAAAC,KAAA,GAAAC,MAAA,CAAAP,CAAA,CAAAQ,QAAA,QAAAC,QAAA;MACA,MAAAC,GAAA,GAAAH,MAAA,CAAAP,CAAA,CAAAW,OAAA,IAAAF,QAAA;MAEA,UAAAL,IAAA,IAAAE,KAAA,IAAAI,GAAA;IACA;EACA;AACA","ignoreList":[]}]}