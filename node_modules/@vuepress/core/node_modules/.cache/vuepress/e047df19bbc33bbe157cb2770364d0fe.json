/span>\r\n        </router-link>\r\n\r\n        <!-- 中间页码 -->\r\n\r\n        <div class=\"pagination-pages\">\r\n          <router-link\r\n            v-for=\"page in pagination.pages\"\r\n            :key=\"page.key\"\r\n            :to=\"page.path\"\r\n            class=\"pagination-page\"\r\n            :class=\"{\r\n              active: page.path === $page.path,\r\n            }\"\r\n          >\r\n            {{ page.number }}\r\n          </router-link>\r\n        </div>\r\n\r\n        <!-- 下一页 -->\r\n\r\n        <router-link v-if=\"pagination.hasNext\" :to=\"pagination.nextLink\" class=\"pagination-arrow pagination-next\">\r\n          <span class=\"pagination-text\"> 下一页 </span>\r\n\r\n          <span class=\"pagination-icon\">→</span>\r\n        </router-link>\r\n      </nav>\r\n    </template>\r\n  </ParentLayout>\r\n</template>\r\n\r\n<script>\r\nimport ParentLayout from '@parent-theme/layouts/Layout.vue'\r\n\r\nexport default {\r\n  name: 'DirectoryPagination',\r\n\r\n  components: {\r\n    ParentLayout,\r\n  },\r\n\r\n  computed: {\r\n    pagination() {\r\n      return this.$pagination\r\n    },\r\n  },\r\n}\r\n</script>\r\n\r\n<style scoped>\r\n/* =========================\r\n   分页整体\r\n   ========================= */\r\n\r\n.custom-pagination {\r\n  display: flex;\r\n\r\n  align-items: center;\r\n\r\n  justify-content: center;\r\n\r\n  gap: 18px;\r\n\r\n  max-width: 900px;\r\n\r\n  margin: 30px auto 60px;\r\n\r\n  padding: 0 30px;\r\n\r\n  box-sizing: border-box;\r\n}\r\n\r\n/* =========================\r\n   上一页 / 下一页\r\n   ========================= */\r\n\r\n.pagination-arrow {\r\n  display: inline-flex;\r\n\r\n  align-items: center;\r\n\r\n  gap: 6px;\r\n\r\n  min-width: 70px;\r\n\r\n  color: #999;\r\n\r\n  font-size: 13px;\r\n\r\n  text-decoration: none;\r\n\r\n  transition: color 0.2s ease, transform 0.2s ease;\r\n}\r\n\r\n.pagination-arrow:hover {\r\n  color: #3eaf7c;\r\n\r\n  text-decoration: none;\r\n}\r\n\r\n.pagination-prev:hover {\r\n  transform: translateX(-2px);\r\n}\r\n\r\n.pagination-next:hover {\r\n  transform: translateX(2px);\r\n}\r\n\r\n.pagination-icon {\r\n  font-size: 16px;\r\n\r\n  line-height: 1;\r\n}\r\n\r\n/* =========================\r\n   页码\r\n   ========================= */\r\n\r\n.pagination-pages {\r\n  display: flex;\r\n\r\n  align-items: center;\r\n\r\n  justify-content: center;\r\n\r\n  gap: 5px;\r\n}\r\n\r\n.pagination-page {\r\n  display: inline-flex;\r\n\r\n  align-items: center;\r\n\r\n  justify-content: center;\r\n\r\n  width: 34px;\r\n\r\n  height: 34px;\r\n\r\n  border-radius: 50%;\r\n\r\n  color: #999;\r\n\r\n  font-size: 13px;\r\n\r\n  text-decoration: none;\r\n\r\n  transition: background 0.2s ease, color 0.2s ease, transform 0.2s ease;\r\n}\r\n\r\n.pagination-page:hover {\r\n  background: #f5f7f6;\r\n\r\n  color: #3eaf7c;\r\n\r\n  text-decoration: none;\r\n\r\n  transform: translateY(-1px);\r\n}\r\n\r\n.pagination-page.active {\r\n  background: #3eaf7c;\r\n\r\n  color: #fff;\r\n\r\n  font-weight: 600;\r\n}\r\n\r\n/* =========================\r\n   没有上一页 / 下一页时\r\n   ========================= */\r\n\r\n.pagination-pages {\r\n  flex-shrink: 0;\r\n}\r\n\r\n/* =========================\r\n   手机端\r\n   ========================= */\r\n\r\n@media (max-width: 719px) {\r\n  .custom-pagination {\r\n    gap: 10px;\r\n\r\n    margin: 25px auto 45px;\r\n\r\n    padding: 0 18px;\r\n  }\r\n\r\n  .pagination-arrow {\r\n    min-width: auto;\r\n\r\n    font-size: 12px;\r\n  }\r\n\r\n  .pagination-icon {\r\n    font-size: 15px;\r\n  }\r\n\r\n  .pagination-page {\r\n    width: 30px;\r\n\r\n    height: 30px;\r\n\r\n    font-size: 12px;\r\n  }\r\n\r\n  .pagination-pages {\r\n    gap: 2px;\r\n  }\r\n}\r\n</style>\r\n"]}]}