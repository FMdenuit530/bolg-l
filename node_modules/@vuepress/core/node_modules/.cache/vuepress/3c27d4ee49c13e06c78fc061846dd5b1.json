{"remainingRequest":"D:\\blog\\node_modules\\babel-loader\\lib\\index.js??ref--3-1!D:\\blog\\node_modules\\cache-loader\\dist\\cjs.js??ref--0-0!D:\\blog\\node_modules\\vue-loader\\lib\\index.js??vue-loader-options!D:\\blog\\docs\\.vuepress\\theme\\layouts\\Search.vue?vue&type=script&lang=js","dependencies":[{"path":"D:\\blog\\docs\\.vuepress\\theme\\layouts\\Search.vue","mtime":1789045976539},{"path":"D:\\blog\\node_modules\\cache-loader\\dist\\cjs.js","mtime":1788081846128},{"path":"D:\\blog\\node_modules\\babel-loader\\lib\\index.js","mtime":1788081850451},{"path":"D:\\blog\\node_modules\\cache-loader\\dist\\cjs.js","mtime":1788081846128},{"path":"D:\\blog\\node_modules\\vue-loader\\lib\\index.js","mtime":1788081851187}],"contextDependencies":[],"result":[{"type":"Buffer","data":"base64:"},{"version":3,"names":["ParentLayout","name","components","data","inputKeyword","computed","searchKeyword","$route","query","String","q","trim","hasKeyword","allPosts","$site","Array","isArray","pages","filter","page","path","startsWith","frontmatter","date","slice","sort","a","b","dateA","Date","getTime","dateB","recentPosts","searchResults","keyword","toLowerCase","post","title","description","category","tags","getPostTags","join","searchText","indexOf","watch","immediate","handler","route","methods","submitSearch","$router","replace","catch","formatDate","d","isNaN","year","getFullYear","month","getMonth","padStart","day","getDate","tag","getTagPath","value"],"sources":["D:/blog/docs/.vuepress/theme/layouts/Search.vue"],"sourcesContent":["\r\nimport ParentLayout from '@parent-theme/layouts/Layout.vue'\r\n\r\nexport default {\r\n  name: 'Search',\r\n\r\n  components: {\r\n    ParentLayout,\r\n  },\r\n\r\n  data() {\r\n    return {\r\n      inputKeyword: '',\r\n    }\r\n  },\r\n\r\n  computed: {\r\n    /* ========================================\r\n     * 当前关键词\r\n     * ======================================== */\r\n\r\n    searchKeyword() {\r\n      if (!this.$route || !this.$route.query) {\r\n        return ''\r\n      }\r\n\r\n      return String(this.$route.query.q || '').trim()\r\n    },\r\n\r\n    /* ========================================\r\n     * 是否正在搜索\r\n     * ======================================== */\r\n\r\n    hasKeyword() {\r\n      return !!this.searchKeyword\r\n    },\r\n\r\n    /* ========================================\r\n     * 所有文章\r\n     * ======================================== */\r\n\r\n    allPosts() {\r\n      if (!this.$site || !Array.isArray(this.$site.pages)) {\r\n        return []\r\n      }\r\n\r\n      return this.$site.pages\r\n        .filter((page) => {\r\n          return page && page.path && page.path.startsWith('/posts/') && page.frontmatter && page.frontmatter.date\r\n        })\r\n        .slice()\r\n        .sort((a, b) => {\r\n          const dateA = new Date(a.frontmatter.date).getTime()\r\n\r\n          const dateB = new Date(b.frontmatter.date).getTime()\r\n\r\n          return dateB - dateA\r\n        })\r\n    },\r\n\r\n    /* ========================================\r\n     * 最近文章\r\n     * ======================================== */\r\n\r\n    recentPosts() {\r\n      return this.allPosts.slice(0, 5)\r\n    },\r\n\r\n    /* ========================================\r\n     * 搜索结果\r\n     * ======================================== */\r\n\r\n    searchResults() {\r\n      const keyword = this.searchKeyword.toLowerCase()\r\n\r\n      if (!keyword) {\r\n        return []\r\n      }\r\n\r\n      return this.allPosts.filter((post) => {\r\n        const frontmatter = post.frontmatter || {}\r\n\r\n        const title = String(post.title || '')\r\n\r\n        const description = String(frontmatter.description || '')\r\n\r\n        const category = String(frontmatter.category || '')\r\n\r\n        const tags = this.getPostTags(post).join(' ')\r\n\r\n        const path = String(post.path || '')\r\n\r\n        const searchText = [title, description, category, tags, path].join(' ').toLowerCase()\r\n\r\n        return searchText.indexOf(keyword) !== -1\r\n      })\r\n    },\r\n  },\r\n\r\n  watch: {\r\n    /* ========================================\r\n     * 地址变化时同步输入框\r\n     * ======================================== */\r\n\r\n    $route: {\r\n      immediate: true,\r\n\r\n      handler(route) {\r\n        if (!route || !route.query) {\r\n          this.inputKeyword = ''\r\n          return\r\n        }\r\n\r\n        this.inputKeyword = String(route.query.q || '')\r\n      },\r\n    },\r\n  },\r\n\r\n  methods: {\r\n    /* ========================================\r\n     * 执行搜索\r\n     * ======================================== */\r\n\r\n    submitSearch() {\r\n      const keyword = String(this.inputKeyword || '').trim()\r\n\r\n      const query = keyword ? { q: keyword } : {}\r\n\r\n      this.$router\r\n        .replace({\r\n          path: '/search/',\r\n          query,\r\n        })\r\n        .catch(() => {})\r\n    },\r\n\r\n    /* ========================================\r\n     * 日期格式\r\n     * ======================================== */\r\n\r\n    formatDate(date) {\r\n      if (!date) {\r\n        return ''\r\n      }\r\n\r\n      const d = new Date(date)\r\n\r\n      if (isNaN(d.getTime())) {\r\n        return date\r\n      }\r\n\r\n      const year = d.getFullYear()\r\n\r\n      const month = String(d.getMonth() + 1).padStart(2, '0')\r\n\r\n      const day = String(d.getDate()).padStart(2, '0')\r\n\r\n      return `${year}-${month}-${day}`\r\n    },\r\n\r\n    /* ========================================\r\n     * 标签\r\n     * ======================================== */\r\n\r\n    getPostTags(post) {\r\n      if (!post || !post.frontmatter) {\r\n        return []\r\n      }\r\n\r\n      const tags = post.frontmatter.tags\r\n\r\n      if (Array.isArray(tags)) {\r\n        return tags\r\n      }\r\n\r\n      if (typeof tags === 'string') {\r\n        return [tags]\r\n      }\r\n\r\n      const tag = post.frontmatter.tag\r\n\r\n      if (Array.isArray(tag)) {\r\n        return tag\r\n      }\r\n\r\n      if (typeof tag === 'string') {\r\n        return [tag]\r\n      }\r\n\r\n      return []\r\n    },\r\n\r\n    /* ========================================\r\n     * 标签地址\r\n     *\r\n     * 和现在已经修好的 Tag.vue\r\n     * 保持同样方式。\r\n     * ======================================== */\r\n\r\n    getTagPath(tag) {\r\n      const value = String(tag == null ? '' : tag).trim()\r\n\r\n      if (!value) {\r\n        return '/tags/'\r\n      }\r\n\r\n      return `/tags/${value}/`\r\n    },\r\n  },\r\n}\r\n"],"mappings":";;AACA,OAAOA,YAAY,MAAM,kCAAkC;AAE3D,eAAe;EACbC,IAAI,EAAE,QAAQ;EAEdC,UAAU,EAAE;IACVF;EACF,CAAC;EAEDG,IAAIA,CAAA,EAAG;IACL,OAAO;MACLC,YAAY,EAAE;IAChB,CAAC;EACH,CAAC;EAEDC,QAAQ,EAAE;IACR;AACJ;AACA;;IAEIC,aAAaA,CAAA,EAAG;MACd,IAAI,CAAC,IAAI,CAACC,MAAM,IAAI,CAAC,IAAI,CAACA,MAAM,CAACC,KAAK,EAAE;QACtC,OAAO,EAAE;MACX;MAEA,OAAOC,MAAM,CAAC,IAAI,CAACF,MAAM,CAACC,KAAK,CAACE,CAAC,IAAI,EAAE,CAAC,CAACC,IAAI,CAAC,CAAC;IACjD,CAAC;IAED;AACJ;AACA;;IAEIC,UAAUA,CAAA,EAAG;MACX,OAAO,CAAC,CAAC,IAAI,CAACN,aAAa;IAC7B,CAAC;IAED;AACJ;AACA;;IAEIO,QAAQA,CAAA,EAAG;MACT,IAAI,CAAC,IAAI,CAACC,KAAK,IAAI,CAACC,KAAK,CAACC,OAAO,CAAC,IAAI,CAACF,KAAK,CAACG,KAAK,CAAC,EAAE;QACnD,OAAO,EAAE;MACX;MAEA,OAAO,IAAI,CAACH,KAAK,CAACG,KAAK,CACpBC,MAAM,CAAEC,IAAI,IAAK;QAChB,OAAOA,IAAI,IAAIA,IAAI,CAACC,IAAI,IAAID,IAAI,CAACC,IAAI,CAACC,UAAU,CAAC,SAAS,CAAC,IAAIF,IAAI,CAACG,WAAW,IAAIH,IAAI,CAACG,WAAW,CAACC,IAAI;MAC1G,CAAC,CAAC,CACDC,KAAK,CAAC,CAAC,CACPC,IAAI,CAAC,CAACC,CAAC,EAAEC,CAAC,KAAK;QACd,MAAMC,KAAK,GAAG,IAAIC,IAAI,CAACH,CAAC,CAACJ,WAAW,CAACC,IAAI,CAAC,CAACO,OAAO,CAAC,CAAC;QAEpD,MAAMC,KAAK,GAAG,IAAIF,IAAI,CAACF,CAAC,CAACL,WAAW,CAACC,IAAI,CAAC,CAACO,OAAO,CAAC,CAAC;QAEpD,OAAOC,KAAK,GAAGH,KAAK;MACtB,CAAC,CAAC;IACN,CAAC;IAED;AACJ;AACA;;IAEII,WAAWA,CAAA,EAAG;MACZ,OAAO,IAAI,CAACnB,QAAQ,CAACW,KAAK,CAAC,CAAC,EAAE,CAAC,CAAC;IAClC,CAAC;IAED;AACJ;AACA;;IAEIS,aAAaA,CAAA,EAAG;MACd,MAAMC,OAAO,GAAG,IAAI,CAAC5B,aAAa,CAAC6B,WAAW,CAAC,CAAC;MAEhD,IAAI,CAACD,OAAO,EAAE;QACZ,OA