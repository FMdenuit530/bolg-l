{"remainingRequest":"D:\\blog\\node_modules\\vue-loader\\lib\\index.js??vue-loader-options!D:\\blog\\docs\\.vuepress\\theme\\layouts\\DirectoryPagination.vue?vue&type=script&lang=js","dependencies":[{"path":"D:\\blog\\docs\\.vuepress\\theme\\layouts\\DirectoryPagination.vue","mtime":1788918964676},{"path":"D:\\blog\\node_modules\\cache-loader\\dist\\cjs.js","mtime":1788081846128},{"path":"D:\\blog\\node_modules\\babel-loader\\lib\\index.js","mtime":1788081850451},{"path":"D:\\blog\\node_modules\\cache-loader\\dist\\cjs.js","mtime":1788081846128},{"path":"D:\\blog\\node_modules\\vue-loader\\lib\\index.js","mtime":1788081851187}],"contextDependencies":[],"result":[{"type":"Buffer","data":"base64:"},{"version":3,"sources":["DirectoryPagination.vue"],"names":[],"mappings":";AA8EA;;AAEA;AACA;;AAEA;AACA;AACA;;AAEA;AACA;AACA;AACA;AACA;AACA;;AAEA;AACA;;AAEA;AACA;AACA;;AAEA;AACA;;AAEA;AACA;AACA;AACA;AACA;;AAEA;AACA;AACA;AACA;;AAEA;AACA;AACA;;AAEA;;AAEA;AACA;;AAEA;AACA;AACA;AACA;AACA;;AAEA;AACA;AACA;AACA;;AAEA;;AAEA;AACA;AACA;;AAEA;AACA;AACA;AACA","file":"DirectoryPagination.vue","sourceRoot":"docs/.vuepress/theme/layouts","sourcesContent":["<template>\r\n  <ParentLayout>\r\n    <!-- =========================\r\n         分页页面底部\r\n         ========================= -->\r\n\r\n    <template slot=\"page-bottom\">\r\n      <nav v-if=\"$pagination\" class=\"custom-pagination\" aria-label=\"文章分页\">\r\n        <!-- =========================\r\n             上一页\r\n             ========================= -->\r\n\r\n        <router-link v-if=\"$pagination.hasPrev\" :to=\"$pagination.prevLink\" class=\"pagination-link pagination-prev\">\r\n          <span class=\"pagination-arrow\"> ← </span>\r\n\r\n          <span> 上一页 </span>\r\n        </router-link>\r\n\r\n        <!-- =========================\r\n             页码\r\n             ========================= -->\r\n\r\n        <div class=\"pagination-pages\">\r\n          <!-- 首页 -->\r\n\r\n          <router-link\r\n            to=\"/\"\r\n            class=\"pagination-page\"\r\n            :class=\"{\r\n              active: currentPage === 1,\r\n            }\"\r\n          >\r\n            1\r\n          </router-link>\r\n\r\n          <!-- 第二页 -->\r\n\r\n          <router-link\r\n            v-if=\"pageCount >= 2\"\r\n            to=\"/page/2/\"\r\n            class=\"pagination-page\"\r\n            :class=\"{\r\n              active: currentPage === 2,\r\n            }\"\r\n          >\r\n            2\r\n          </router-link>\r\n\r\n          <!-- 第三页以后 -->\r\n\r\n          <router-link\r\n            v-for=\"page in extraPages\"\r\n            :key=\"page\"\r\n            :to=\"`/page/${page}/`\"\r\n            class=\"pagination-page\"\r\n            :class=\"{\r\n              active: currentPage === page,\r\n            }\"\r\n          >\r\n            {{ page }}\r\n          </router-link>\r\n        </div>\r\n\r\n        <!-- =========================\r\n             下一页\r\n             ========================= -->\r\n\r\n        <router-link v-if=\"$pagination.hasNext\" :to=\"$pagination.nextLink\" class=\"pagination-link pagination-next\">\r\n          <span> 下一页 </span>\r\n\r\n          <span class=\"pagination-arrow\"> → </span>\r\n        </router-link>\r\n      </nav>\r\n    </template>\r\n  </ParentLayout>\r\n</template>\r\n\r\n<script>\r\nimport ParentLayout from '@parent-theme/layouts/Layout.vue'\r\n\r\nexport default {\r\n  name: 'DirectoryPagination',\r\n\r\n  components: {\r\n    ParentLayout,\r\n  },\r\n\r\n  computed: {\r\n    /*\r\n     * ========================================\r\n     * 当前页\r\n     * ========================================\r\n     */\r\n\r\n    currentPage() {\r\n      const match = this.$page.path.match(/\\/page\\/(\\d+)\\/?$/)\r\n\r\n      if (match) {\r\n        return Number(match[1])\r\n      }\r\n\r\n      return 1\r\n    },\r\n\r\n    /*\r\n     * ========================================\r\n     * 总页数\r\n     * ========================================\r\n     */\r\n\r\n    pageCount() {\r\n      if (!this.$pagination) {\r\n        return 1\r\n      }\r\n\r\n      /*\r\n       * 你现在每页 2 篇文章\r\n       */\r\n\r\n      const length = this.$pagination.length || 0\r\n\r\n      return Math.max(1, Math.ceil(length / 2))\r\n    },\r\n\r\n    /*\r\n     * ========================================\r\n     * 第三页以后的页码\r\n     * ========================================\r\n     */\r\n\r\n    extraPages() {\r\n      if (this.pageCount <= 2) {\r\n        return []\r\n      }\r\n\r\n      const pages = []\r\n\r\n      for (let i = 3; i <= this.pageCount; i++) {\r\n        pages.push(i)\r\n      }\r\n\r\n      return pages\r\n    },\r\n  },\r\n}\r\n</script>\r\n\r\n<style scoped>\r\n/* =========================\r\n   分页整体\r\n   ========================= */\r\n\r\n.custom-pagination {\r\n  max-width: 900px;\r\n\r\n  margin: 45px auto 55px;\r\n\r\n  padding: 30px 30px 0;\r\n\r\n  border-top: 1px solid #eeeeee;\r\n\r\n  box-sizing: border-box;\r\n\r\n  display: flex;\r\n\r\n  align-items: center;\r\n\r\n  justify-content: center;\r\n\r\n  gap: 20px;\r\n}\r\n\r\n/* =========================\r\n   上一页 / 下一页\r\n   ========================= */\r\n\r\n.pagination-link {\r\n  display: inline-flex;\r\n\r\n  align-items: center;\r\n\r\n  gap: 6px;\r\n\r\n  color: #999;\r\n\r\n  font-size: 13px;\r\n\r\n  line-height: 1;\r\n\r\n  text-decoration: none;\r\n\r\n  white-space: nowrap;\r\n\r\n  transition: color 0.2s ease, transform 0.2s ease;\r\n}\r\n\r\n.pagination-link:hover {\r\n  color: #3eaf7c;\r\n\r\n  text-decoration: none;\r\n}\r\n\r\n.pagination-prev:hover {\r\n  transform: translateX(-2px);\r\n}\r\n\r\n.pagination-next:hover {\r\n  transform: translateX(2px);\r\n}\r\n\r\n.pagination-arrow {\r\n  font-size: 16px;\r\n\r\n  line-height: 1;\r\n}\r\n\r\n/* =========================\r\n   页码\r\n   ========================= */\r\n\r\n.pagination-pages {\r\n  display: flex;\r\n\r\n  align-items: center;\r\n\r\n  gap: 5px;\r\n}\r\n\r\n.pagination-page {\r\n  display: inline-flex;\r\n\r\n  align-items: center;\r\n\r\n  justify-content: center;\r\n\r\n  width: 34px;\r\n\r\n  height: 34px;\r\n\r\n  border-radius: 50%;\r\n\r\n  color: #999;\r\n\r\n  font-size: 13px;\r\n\r\n  line-height: 1;\r\n\r\n  text-decoration: none;\r\n\r\n  transition: background 0.2s ease, color 0.2s ease, transform 0.2s ease;\r\n}\r\n\r\n.pagination-page:hover {\r\n  background: #f5f7f6;\r\n\r\n  color: #3eaf7c;\r\n\r\n  text-decoration: none;\r\n\r\n  transform: translateY(-1px);\r\n}\r\n\r\n.pagination-page.active {\r\n  background: #3eaf7c;\r\n\r\n  color: #fff;\r\n\r\n  font-weight: 600;\r\n}\r\n\r\n/* =========================\r\n   手机\r\n   ========================= */\r\n\r\n@media (max-width: 719px) {\r\n  .custom-pagination {\r\n    margin: 35px auto 45px;\r\n\r\n    padding: 25px 18px 0;\r\n\r\n    gap: 10px;\r\n  }\r\n\r\n  .pagination-link {\r\n    font-size: 12px;\r\n  }\r\n\r\n  .pagination-arrow {\r\n    font-size: 15px;\r\n  }\r\n\r\n  .pagination-pages {\r\n    gap: 2px;\r\n  }\r\n\r\n  .pagination-page {\r\n    width: 30px;\r\n\r\n    height: 30px;\r\n\r\n    font-size: 12px;\r\n  }\r\n}\r\n</style>\r\n"]}]}